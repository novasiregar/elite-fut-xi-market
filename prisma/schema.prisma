// ============================================================
// ELITE FUT XI MARKET — Prisma Database Schema
// Financial system: Internal Ledger / Accounting ONLY
// Platform does NOT hold real funds
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  USER
  BUYER
  SELLER
  ADMIN
  MIDMAN
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  RESUBMIT
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  ARCHIVED
  SUSPENDED
}

enum Platform {
  PC
  PLAYSTATION
  XBOX
  MOBILE
  NINTENDO
}

enum TransferMethod {
  FULL_ACCESS
  EMAIL_CHANGE
  MIDMAN
  GIFT
}

enum OrderStatus {
  CREATED
  WAITING_PAYMENT
  PAID
  ESCROW_HOLD
  DELIVERED
  COMPLETED
  DISPUTED
  REFUNDED
  RELEASED
  CANCELLED
}

enum LedgerType {
  PAYMENT_RECEIVED
  ESCROW_HOLD
  ESCROW_RELEASE
  PLATFORM_FEE
  REFUND
  REFUND_RELEASE
  WITHDRAW_REQUEST
  WITHDRAW_APPROVED
  WITHDRAW_COMPLETED
  WITHDRAW_REJECTED
  ADMIN_ADJUSTMENT
  DISPUTE_HOLD
  DISPUTE_REFUND
  DISPUTE_RELEASE
}

enum PaymentMethod {
  QRIS
  VIRTUAL_ACCOUNT
  EWALLET
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUND
  RESOLVED_RELEASE
  CLOSED
}

enum WithdrawStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum NotificationType {
  ORDER_CREATED
  ORDER_PAID
  ORDER_DELIVERED
  ORDER_COMPLETED
  ORDER_CANCELLED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  WITHDRAW_REQUESTED
  WITHDRAW_APPROVED
  WITHDRAW_COMPLETED
  WITHDRAW_REJECTED
  KYC_APPROVED
  KYC_REJECTED
  SYSTEM
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_BANNED
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  LISTING_CREATED
  LISTING_UPDATED
  LISTING_SUSPENDED
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  PAYMENT_RECEIVED
  ESCROW_HOLD
  ESCROW_RELEASED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  WITHDRAW_REQUESTED
  WITHDRAW_APPROVED
  WITHDRAW_COMPLETED
  WITHDRAW_REJECTED
  LEDGER_ADJUSTMENT
  ADMIN_LOGIN
}

// ============================================================
// USERS
// ============================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified DateTime?
  username      String   @unique
  displayName   String?
  passwordHash  String?
  avatarUrl     String?
  role          Role     @default(USER)
  isActive      Boolean  @default(true)
  isBanned      Boolean  @default(false)
  bannedReason  String?
  bannedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  kyc               Kyc?
  wallet            Wallet?
  listingsAsSeller  Listing[]           @relation("SellerListings")
  ordersAsBuyer     Order[]             @relation("BuyerOrders")
  ordersAsSeller    Order[]             @relation("SellerOrders")
  ledgerEntries     LedgerEntry[]
  disputes          Dispute[]           @relation("BuyerDisputes")
  disputesAsSeller  Dispute[]           @relation("SellerDisputes")
  withdrawRequests  WithdrawRequest[]
  notifications     Notification[]
  auditLogs         AuditLog[]          @relation("AuditTarget")
  auditLogsCreated  AuditLog[]          @relation("AuditCreator")
  reviews           Review[]            @relation("ReviewAuthor")
  receivedReviews   Review[]            @relation("ReviewTarget")

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// KYC / SELLER VERIFICATION
// ============================================================

model Kyc {
  id               String    @id @default(cuid())
  userId           String    @unique
  identityNumber   String
  identityType     String    @default("KTP")
  identityDocument String    // Cloudinary URL
  selfiePhoto      String    // Cloudinary URL
  bankName         String?
  bankAccountNumber String?
  bankAccountName  String?
  status           KycStatus @default(PENDING)
  reviewNote       String?
  reviewedBy       String?
  reviewedAt       DateTime?
  submittedAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("kyc")
}

// ============================================================
// WALLET (Accounting summary — derived from ledger)
// ============================================================

model Wallet {
  id                String   @id @default(cuid())
  userId            String   @unique
  balanceAvailable  BigInt   @default(0) // in smallest currency unit (e.g. IDR cents)
  balancePending    BigInt   @default(0)
  balanceWithdrawn  BigInt   @default(0)
  balanceRefunded   BigInt   @default(0)
  totalEarned       BigInt   @default(0)
  currency          String   @default("IDR")
  lastRecalcAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

// ============================================================
// LEDGER (Immutable financial event log)
// CRITICAL: This is the financial backbone — DO NOT MODIFY entries
// ============================================================

model LedgerEntry {
  id          String      @id @default(cuid())
  userId      String
  amount      BigInt      // positive = credit, negative = debit
  currency    String      @default("IDR")
  type        LedgerType
  referenceId String?     // orderId, withdrawId, etc.
  referenceType String?   // "ORDER", "WITHDRAW", "DISPUTE"
  description String
  metadata    Json?       // extra data for audit trail
  createdAt   DateTime    @default(now())
  createdBy   String?     // userId of admin or system

  // Immutability enforced at application layer
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ============================================================
// LISTINGS
// ============================================================

model Listing {
  id              String        @id @default(cuid())
  sellerId        String
  title           String
  slug            String        @unique
  description     String        @db.Text
  price           BigInt        // in IDR
  coins           BigInt?       // FIFA coins amount
  rating          Int?          // account rating (OVR)
  platform        Platform
  accountLevel    Int?
  transferMethod  TransferMethod
  status          ListingStatus @default(DRAFT)
  viewCount       Int           @default(0)
  isFeatured      Boolean       @default(false)
  images          ListingImage[]
  tags            String[]
  // Account details — only revealed after order ESCROW_HOLD
  accountEmail    String?       // encrypted
  accountPassword String?       // encrypted
  accountDetails  String?       @db.Text // encrypted JSON
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  publishedAt     DateTime?

  seller  User    @relation("SellerListings", fields: [sellerId], references: [id])
  orders  Order[]

  @@index([sellerId])
  @@index([status])
  @@index([platform])
  @@index([price])
  @@index([createdAt])
  @@index([isFeatured])
  @@map("listings")
}

model ListingImage {
  id          String   @id @default(cuid())
  listingId   String
  url         String   // Cloudinary URL (WebP optimized)
  publicId    String   // Cloudinary public_id for deletion
  altText     String?
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

// ============================================================
// ORDERS
// ============================================================

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // human-readable: ORD-20241201-XXXX
  buyerId         String
  sellerId        String
  listingId       String
  price           BigInt      // price at time of order
  platformFee     BigInt      // platform commission
  sellerReceives  BigInt      // price - platformFee
  currency        String      @default("IDR")
  status          OrderStatus @default(CREATED)
  statusHistory   Json        @default("[]") // [{status, at, by, note}]
  // Delivery info — revealed after ESCROW_HOLD confirmed
  deliveryNote    String?     @db.Text
  deliveredAt     DateTime?
  confirmedAt     DateTime?
  autoConfirmAt   DateTime?   // auto-confirm deadline
  cancelledAt     DateTime?
  cancelReason    String?
  // Payment info
  payment         Payment?
  // Relations
  dispute         Dispute?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  buyer   User    @relation("BuyerOrders",  fields: [buyerId],   references: [id])
  seller  User    @relation("SellerOrders", fields: [sellerId],  references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

// ============================================================
// PAYMENTS (Xendit invoices)
// ============================================================

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  xenditInvoiceId String        @unique // Xendit's invoice ID
  xenditPaymentId String?       // Xendit's payment ID after paid
  amount          BigInt
  currency        String        @default("IDR")
  method          PaymentMethod?
  status          PaymentStatus @default(PENDING)
  invoiceUrl      String        // Xendit hosted checkout URL
  expiresAt       DateTime
  paidAt          DateTime?
  webhookPayload  Json?         // raw webhook for audit
  idempotencyKey  String        @unique // prevents duplicate processing
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([xenditInvoiceId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("payments")
}

// ============================================================
// DISPUTES
// ============================================================

model Dispute {
  id          String        @id @default(cuid())
  orderId     String        @unique
  buyerId     String
  sellerId    String
  reason      String
  description String        @db.Text
  evidence    Json          @default("[]") // [{url, type, uploadedBy, at}]
  status      DisputeStatus @default(OPEN)
  adminNote   String?       @db.Text
  resolvedBy  String?
  resolvedAt  DateTime?
  resolution  String?       // "REFUND" | "RELEASE"
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order  Order @relation(fields: [orderId],  references: [id])
  buyer  User  @relation("BuyerDisputes",  fields: [buyerId],   references: [id])
  seller User  @relation("SellerDisputes", fields: [sellerId],  references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@map("disputes")
}

// ============================================================
// WITHDRAWAL REQUESTS (Manual payout model)
// ============================================================

model WithdrawRequest {
  id              String         @id @default(cuid())
  userId          String
  amount          BigInt
  currency        String         @default("IDR")
  bankName        String
  bankAccountNumber String
  bankAccountName String
  status          WithdrawStatus @default(PENDING)
  adminNote       String?
  processedBy     String?
  processedAt     DateTime?
  completedAt     DateTime?
  rejectedAt      DateTime?
  rejectedReason  String?
  ledgerEntryId   String?        // linked WITHDRAW_REQUEST ledger entry
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("withdraw_requests")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  data        Json?            // extra context (orderId, etc.)
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id         String   @id @default(cuid())
  orderId    String   @unique
  authorId   String
  targetId   String
  rating     Int      // 1-5
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation("ReviewAuthor", fields: [authorId], references: [id])
  target User @relation("ReviewTarget", fields: [targetId], references: [id])

  @@index([targetId])
  @@index([authorId])
  @@map("reviews")
}

// ============================================================
// AUDIT LOGS (Immutable admin action trail)
// ============================================================

model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  targetId    String?     // userId, orderId, etc.
  targetType  String?     // "USER", "ORDER", "LISTING", etc.
  targetUser  User?       @relation("AuditTarget",  fields: [targetId],  references: [id])
  createdById String?
  createdBy   User?       @relation("AuditCreator", fields: [createdById], references: [id])
  description String
  metadata    Json?       // snapshot of state before/after
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  @@index([action])
  @@index([targetId])
  @@index([createdById])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// SYSTEM CONFIG (Admin-managed platform settings)
// ============================================================

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String?
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("system_config")
}
