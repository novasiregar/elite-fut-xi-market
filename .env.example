# ============================================================
# ELITE FUT XI MARKET — Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-minimum-32-chars
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/elite_fut_xi?schema=public"

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Xendit Payment Gateway ---
XENDIT_SECRET_KEY=xnd_production_XXXXXXXX
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-verification-token
XENDIT_CALLBACK_URL=https://yourdomain.com/api/webhooks/xendit

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM="ELITE FUT XI <noreply@yourdomain.com>"

# --- Platform Config ---
PLATFORM_FEE_PERCENT=5
MIN_WITHDRAWAL_AMOUNT=50000
CURRENCY=IDR
